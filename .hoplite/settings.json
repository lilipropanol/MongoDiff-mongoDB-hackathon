{
	"version": 1,
	"inference": {
		"run": {
			"detectorVersion": 4,
			"framework": "fastapi",
			"workspacePath": null
		}
	},
	"ports": {
		"preview": 8000,
		"additional": {}
	},
	"services": [],
	"scripts": {
		"setup": {
			"enabled": true,
			"command": "uv venv --allow-existing .venv && uv pip install --python .venv/bin/python -e '.[dev]' && npm --prefix frontend ci && npm --prefix frontend run build"
		},
		"run": {
			"enabled": true,
			"command": "MONGODB_URI='' .venv/bin/python -m uvicorn schema_guard.server:app --reload --host 0.0.0.0 --port 8000"
		},
		"archive": {
			"enabled": true,
			"command": null
		}
	},
	"mcpServers": []
}
