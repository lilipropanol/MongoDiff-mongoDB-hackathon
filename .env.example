# Optional: without a URI the dashboard still runs its isolated demo.
MONGODB_URI=
MONGODB_DATABASE=sample_mflix
MONGODB_COLLECTION=movies
GUARD_OLD_MODEL=examples/models_old.py:Movie
GUARD_NEW_MODEL=examples/models_new.py:Movie
GUARD_REPORT_DIR=reports
# Use GUARD_OLD_MODEL=collection-validator to read the current Atlas validator.
# Optional suggestions (off by default): GUARD_SUGGESTIONS=voyage
# VOYAGE_API_KEY=
# For atlas-vector, also set GUARD_VECTOR_COLLECTION=guard.suggestion_vectors
